# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (if applicable)
NEXT_PUBLIC_GA_ID=

# API Keys (Placeholders)
# MAPS_API_KEY=
# CONTACT_FORM_SECRET=

# --- Admin CMS (/admin) ---
# Login credentials for the single admin account. Set your own values —
# do not use these placeholders in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Random long string used to sign admin login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# GitHub personal access token (fine-grained, Contents: Read and write, on
# this repo only) used so admin saves can commit content changes — the site
# has no writable filesystem in production, so this is how edits persist.
GITHUB_TOKEN=
GITHUB_OWNER=Mudasirh120
GITHUB_REPO=greentek-construction-website-main
GITHUB_BRANCH=main
